# 复制为 .env 并填写。Phase 0 全部可留空（只用公共数据）。
# Phase 2+ 才需要 Bitget 密钥；交易 key 绝不开提现/划转权限，并绑定 IP 白名单。

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# 情报层 LLM 新闻打分 —— 走 OpenRouter 接口（推荐，2026-07-13 起）
# 模型默认 deepseek/deepseek-v4-flash，可用 OPENROUTER_MODEL 覆盖
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# 备选：DeepSeek 直连（仅当未配置 OPENROUTER_API_KEY 时使用）
DEEPSEEK_API_KEY=

# Phase 2 运维告警
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
